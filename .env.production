# Production Environment Variables for HomeChefs AI
# Copy this file to .env.production and fill in actual values

# Django Configuration
SECRET_KEY=your-super-secret-key-here
DEBUG=False
ALLOWED_HOSTS=13.204.86.218,homechefhub.in,www.homechefhub.in

# Database Configuration (AWS RDS)
DATABASE_URL=sqlite:///db.sqlite3

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=http://homechefs-ai-media-1787548385.s3.amazonaws.com/
AWS_S3_REGION_NAME=ap-south-1

# MSG91 (SMS / OTP)
MSG91_AUTHKEY=565368At584Y6YF6a970c9cP1
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_SENDER_ID=HCFAIO
MSG91_BASE_URL=https://api.msg91.com/api/v5/otp
MSG91_WIDGET_ID=366961717371313136353533

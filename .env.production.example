# Production Environment Variables for HomeChefs AI
# Copy this file to .env.production and fill in actual values

# Django Configuration
SECRET_KEY=your-super-secret-key-here
DEBUG=False
ALLOWED_HOSTS=homechefhub.in,www.homechefhub.in

# Database Configuration (AWS RDS)
DATABASE_URL=postgres://username:password@rds-endpoint:5432/dbname

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=homechefhub-media
AWS_S3_REGION_NAME=ap-south-1

# Redis Configuration (ElastiCache)
REDIS_URL=redis://redis-endpoint:6379/1

# Email Configuration (AWS SES)
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-ses-smtp-username
EMAIL_HOST_PASSWORD=your-ses-smtp-password
DEFAULT_FROM_EMAIL=noreply@homechefhub.in

# Error Tracking (Optional)
SENTRY_DSN=your-sentry-dsn

# Security
CSRF_TRUSTED_ORIGINS=https://homechefhub.in,https://www.homechefhub.in
